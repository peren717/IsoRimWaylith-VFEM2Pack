<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim Waylith models for VFE Medieval 2's walls, grape plant and draughts (Grok, coop delivery
       20261020-2241 VFEM2_Walls_Plants_Draughts). Format as Defs\VFEM2_Models.xml. -->

  <!-- Walls: none bound for now. The low castle walls go back to IsoRim's own look (low block; the damaged one flat, as
       VFEM2 makes it standable rubble) until Grok redoes them to match VFEM2's atlas (user 2026-10-20): the intact one with a
       raised top that runs on through its joins, the damaged one as low rubble on the ground. The full-height walls
       (castle, damaged castle, timbered, palisade, cloth) keep IsoRim's wall block: a wall drawn from a model is not cut
       down by the cut-away yet. -->

  <!-- Grape plant: two variants as the game's Graphic_Random, scaled by growth; leaf* parts drop while leafless. -->
  <IsoRim.ModelDef>
    <defName>R3D_VFEM2_Plant_Grape</defName>
    <thingDef>VFEM2_Plant_Grape</thingDef>
    <models>
      <li>Models/vfem2_grape_1.obj</li>
      <li>Models/vfem2_grape_2.obj</li>
    </models>
    <surfaceHeight>0.00</surfaceHeight>
    <randomRotation>true</randomRotation>
    <scaleJitter>0.10</scaleJitter>
    <growthScale>true</growthScale>
    <scatter>0.16</scatter>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

  <!-- Draughts: small bottles, fixed colours; as IsoRim's drugs, used while items are not made from their own art. -->
