<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim Waylith models for VFE Medieval 2's Viking style (Ideology, style category VFEM2_Viking), batch 3 (Grok,
       coop delivery 20261019-2247 VFEM2_Batch3). Each def is for one vanilla thing in one ThingStyleDef only (<style>):
       IsoRim fits it into that thing's own model entry, so things of other styles keep IsoRim's own models. Each has its
       own builtFor. Several models: one per Graphic_Random sprite (A, B, C), picked as the game picks the sprite.
       Lamps are fixed colours with glow_ lenses; everything else takes the stuff colour in its stuff* parts.
       The Viking ideograms are flat in the game and have no model. Table_1x1c is Vanilla Furniture Expanded's: used
       only while that mod gives the table a model entry of its own. -->

  <IsoRim.ModelDef>
    <defName>R3D_VFEM2_Viking_ChessTable</defName>
    <thingDef>ChessTable</thingDef>
    <style>VFEM2_Viking_ChessTable</style>
    <model>Models/vfem2_viking_chess_table.obj</model>
    <outlineMinSize>0.3</outlineMinSize>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>

  <IsoRim.ModelDef>
    <defName>R3D_VFEM2_Viking_Column</defName>
    <thingDef>Column</thingDef>
    <style>VFEM2_Viking_Column</style>
    <model>Models/vfem2_viking_column.obj</model>
    <builtFor>(1, 1)</builtFor>
  </IsoRim.ModelDef>

