<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VFE Medieval 2 walls drawn from models only when IsoRim has Api 10 or later (user 2026-10-21): an older IsoRim draws a
       wall model as a plain model (joint lines, not cut by the cut-away, merlons through floors), so with it these walls keep
       IsoRim's own wall block.
       The wall entries live in Defs\VFEM2_Models_Walls.xml with no thingDef (IsoRim skips an entry that names no thing);
       this patch only gives them their thing.
       It never adds or replaces a whole entry: a def added or replaced by a patch has no mod of its own (modContentPack is
       null), so IsoRim would find none of its model files and draw the thing as before. -->
  <Operation Class="IsoRimVFEM2Pack.PatchOperation_IfIsoRimApi">
    <minVersion>10</minVersion>
    <apply Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEM2_TimberedWall"]</xpath>
          <value><thingDef>VFEM2_TimberedWall</thingDef></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEM2_Palisade"]</xpath>
          <value><thingDef>VFEM2_Palisade</thingDef></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/IsoRim.ModelDef[defName="R3D_VFEM2_ClothWall"]</xpath>
          <value><thingDef>VFEM2_ClothWall</thingDef></value>
        </li>
      </operations>
    </apply>
  </Operation>
</Patch>
